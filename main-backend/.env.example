# ═══════════════════════════════════════════════════════════════════════════
# Lampose Main Backend — environment
#
# Copy to .env and fill in. Anything below that is commented out has a working
# default; the uncommented ones must be set before a production deploy.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=5000
# HOST=0.0.0.0

# ── Database ───────────────────────────────────────────────────────────────
# One database holds everything. Two data domains, kept apart by collection:
#
#   properties                                   shared with the
#                                                onboard.lampose.com backend
#   scriper_users / scriper_jobs / scriper_leads  this backend's alone
#
# The prefix matters: that other backend writes to the same database and its
# code is not in this repo, so a generic name like `users` could collide.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/lamp_onboarding?retryWrites=true&w=majority

# Overrides the database named in the URI. Rarely needed.
# DB_NAME=lamp_onboarding

# Storage for the scriper data (users/jobs/leads) only:
# auto  — MongoDB when a URI resolves, local JSON files otherwise (default)
# mongo — MongoDB, and refuse to start without a URI
# json  — always the files in data/. Never use in production: a container
#         filesystem is wiped on every deploy.
# SCRIPER_STORAGE=auto

# ── Secrets ────────────────────────────────────────────────────────────────
# Signs every login token. Must be long and random; the server refuses to
# start in production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# JWT_EXPIRES_IN=7d

# Required to register an account with the ADMIN role.
ADMIN_SECRET_KEY=change_me_too

# Guards /api/users and the property write routes. Every frontend already
# sends its bearer token, so leave this on unless a client genuinely cannot.
# REQUIRE_AUTH=true

# Creates the demo accounts (admin@scriper.com / admin123) when the user
# collection is empty. Defaults to true in development, false in production —
# those credentials are public knowledge.
# SEED_DEFAULT_USERS=false

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated. These are *added* to the built-in list, which already
# covers the three production frontends — lampose.com (+www), leads.lampose.com
# and onboard.lampose.com — plus api.lampose.com, localhost 3000 / 4173 / 5173 /
# 5174, and any *.lampose.com, *.vercel.app, *.netlify.app, *.onrender.com
# preview URL. Only add hosts outside that set.
# ALLOWED_ORIGINS=https://another-frontend.example.com
# CORS_ORIGIN=            # accepted as an alias, for the older deployment
# CORS_ALLOW_ALL=false    # emergency switch; do not leave on in production

# ── Scraper ────────────────────────────────────────────────────────────────
# Playwright's Chromium must exist on the host:
#   npx playwright install --with-deps chromium
# Without it the API still runs and only /api/scraper/start answers 503.
# SCRAPER_ENABLED=true
# SCRAPER_DEFAULT_DEPTH=15
# SCRAPER_MAX_DEPTH=100
# Pads short Google Maps results with generated rows. Off by default: the
# invented leads are indistinguishable from real ones once they are saved.
# SCRAPER_FILL_SHORT_RESULTS=false

# ── Misc ───────────────────────────────────────────────────────────────────
# TRUST_PROXY=true        # required behind Render / Railway / Nginx
# BODY_LIMIT=1mb
# REQUEST_LOGGING=true
# DB_RETRY_MS=5000
