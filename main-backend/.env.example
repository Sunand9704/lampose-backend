# ═══════════════════════════════════════════════════════════════════════════
# Lampose Main Backend — environment
#
# Copy to .env and fill in. Anything commented out has a working default;
# the uncommented ones should be set before a production deploy.
#
# One process serves three frontends:
#   lampose.com          → /api/v2/listings
#   leads.lampose.com    → /api/v2/{auth,users,scraper,properties}
#   onboard.lampose.com  → /api/v1/{properties,permissions,…} + /api/v2/auth
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=5001
# HOST=0.0.0.0

# ── Database ───────────────────────────────────────────────────────────────
# One database holds everything, split by collection:
#
#   properties, admins, verificationrequests, permissionrequests   v1
#   properties, scriper_users, scriper_jobs, scriper_leads         v2
#
# `properties` is shared by both surfaces on purpose: a listing onboarded
# through onboard.lampose.com is what lampose.com then shows.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/lamp_onboarding?retryWrites=true&w=majority

# Overrides the database named in the URI. Rarely needed.
# DB_NAME=lamp_onboarding

# Storage for the leads data (users/jobs/leads) only:
#   auto  — MongoDB when a URI resolves, local JSON files otherwise (default)
#   mongo — MongoDB, and refuse to start without a URI
#   json  — always the files in data/. Never use in production: a container
#           filesystem is wiped on every deploy.
# SCRIPER_STORAGE=auto

# How long to wait for the cluster before falling back / retrying.
# DB_TIMEOUT_MS=8000
# DB_RETRY_MS=5000

# ── Secrets ────────────────────────────────────────────────────────────────
# Signs every /api/v2/auth login token, and the /api/v1/admin one. Must be
# long and random — 32 characters or more. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Missing in production, the server still boots (the public site and the
# onboarding app must keep working) but /api/v2/auth and /api/v2/users answer
# 503 AUTH_NOT_CONFIGURED rather than issue a forgeable token.
JWT_SECRET=change_me_to_a_long_random_string
# JWT_EXPIRES_IN=7d

# Required to register an account with the ADMIN role via /api/v2/auth/register.
ADMIN_SECRET_KEY=change_me_too

# The v1 admin console's own registration key (/api/v1/admin/register), which
# is a DIFFERENT identity system from the one ADMIN_SECRET_KEY above guards.
# Falls back to the literal in routes/v1/adminRoutes.js when unset — and that
# literal is in the repo, so set this before anyone can reach the console.
# V1_ADMIN_SECRET_KEY=

# Guards /api/v2/users and the v2 property write routes. Every frontend
# already sends its bearer token, so leave this on unless a client cannot.
# REQUIRE_AUTH=true

# Creates the demo accounts (admin@scriper.com / admin123) when the user
# collection is empty. Keep false when MONGO_URI points at a real cluster.
SEED_DEFAULT_USERS=false

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated, *added* to the built-in list in config/env.js, which
# already covers lampose.com (+www), leads.lampose.com, onboard.lampose.com,
# api.lampose.com, localhost 3000/4173/5173/5174/5175/8004, and any
# *.lampose.com / *.vercel.app / *.netlify.app / *.onrender.com preview URL.
ALLOWED_ORIGINS=
# CORS_ORIGIN=              # alias, for the older leads deployment
# CORS_ALLOWED_ORIGINS=     # alias, for the older onboarding deployment
# CORS_ALLOW_ALL=false      # emergency switch; do not leave on in production

# ── Cloudinary (v1 image upload) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Twilio / WhatsApp (v1 owner verification) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved WhatsApp template sent to the property owner.
TWILIO_VERIFY_CONTENT_SID=
# Optional second template for the verification team. Falls back to the owner
# template when unset.
# TWILIO_TEAM_CONTENT_SID=
# Comma-separated whatsapp:+E164 numbers. When EMPTY, an owner's YES
# auto-verifies the property with no second pair of eyes — set this to put a
# verifier in the loop. (routes/v1/verificationRoutes.js)
# VERIFICATION_TEAM_NUMBERS=whatsapp:+919000000000,whatsapp:+919000000001
# Linked in the "your property is live" message sent after verification.
# PRODUCTION_WEBSITE_URL=https://lampose.com
VERIFICATION_TTL_HOURS=48
DEFAULT_PHONE_REGION=IN
ALLOW_UNSIGNED_WEBHOOKS=false
PUBLIC_BASE_URL=

# ── Permissions (v1) ───────────────────────────────────────────────────────
# How long an administrator's edit/delete grant stays spendable.
# PERMISSION_GRANT_TTL_HOURS=24

# ── Scraper (v2) ───────────────────────────────────────────────────────────
# Playwright's Chromium must exist on the host:
#   npm run browsers
# Without it the API still runs and only /api/v2/scraper/start answers 503.
# SCRAPER_ENABLED=true
# SCRAPER_DEFAULT_DEPTH=15
# SCRAPER_MAX_DEPTH=100
# Pads short Google Maps results with generated rows. Off by default: the
# invented leads are indistinguishable from real ones once they are saved.
# SCRAPER_FILL_SHORT_RESULTS=false

# ── Logging & misc ─────────────────────────────────────────────────────────
# Every API call is printed to the console. Bodies are redacted for password,
# token, secret and adminCode fields, and base64 images are shown as a size.
# REQUEST_LOGGING=true
# REQUEST_LOG_BODY=true
# REQUEST_LOG_BODY_CHARS=500
# TRUST_PROXY=true          # required behind Nginx / Render / Railway
# 25mb, not 1mb: the onboarding app posts base64 images in the JSON body.
# BODY_LIMIT=25mb
